{
  "name": "jevgames",
  "version": "0.1.0",
  "description": "Autonomous Clash Royale agent powered by TypeSafe Jev and vision models via macOS iPhone Mirroring",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "test": "tsx test/test_tactics.ts && tsx test/test_perceive.ts",
    "dry-run": "tsx src/index.ts --dry-run",
    "list-windows": "tsx src/index.ts --list-windows",
    "compile-native": "swiftc native/helper.swift -o bin/helper",
    "test:tactics": "tsx test/test_tactics.ts",
    "test:perceive": "tsx test/test_perceive.ts",
    "build-card-index": "python3 tools/build_card_index.py",
    "local": "tsx src/index.ts --local-only",
    "capture": "tsx src/index.ts --capture-only",
    "fetch-card-assets": "bash tools/fetch_card_assets.sh",
    "dev": "tsx src/index.ts --dashboard",
    "dev:dry": "tsx src/index.ts --dashboard --dry-run"
  },
  "keywords": [
    "clash-royale",
    "typesafe",
    "jev",
    "automation",
    "vision"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^17.4.2",
    "openai": "^7.17.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}