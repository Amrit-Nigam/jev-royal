# TypeSafe AI API key. Optional: without it the agent runs on local tactics
# alone (see --local-only), which is fully playable.
TYPESAFE_API_KEY=apikey_...

# Loop interval in milliseconds. Clash Royale punishes slow reactions, so this
# is deliberately fast; perception costs about 60ms without OCR.
TICK_INTERVAL_MS=700

# Input tool: "native" (compiled Swift CGEvent helper) or "cliclick"
CLICK_TOOL=native

# Optional override for the card recognition index built by
# `npm run build-card-index`. Defaults to ./assets/card-index.json
# CARD_INDEX_PATH=
