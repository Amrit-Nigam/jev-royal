# TypeSafe AI API Key
TYPESAFE_API_KEY=apikey_...

# Vision provider: "local" (Apple Vision OCR, 0 keys, coarse), "anthropic", or "openai"
VISION_PROVIDER=anthropic

# Anthropic API Key (for Vision perception) - needs credit at console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Vision Model. Defaults to Haiku (fast/cheap) for Anthropic, gpt-4o-mini for OpenAI.
VISION_MODEL=claude-haiku-4-5-20251001

# Loop interval in milliseconds (default: 2000)
TICK_INTERVAL_MS=2000

# Input tool: "native" (uses compiled Swift CGEvent helper) or "cliclick"
CLICK_TOOL=native
